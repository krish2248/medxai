# MedXAI — example environment file. Copy to `.env` and fill in.
# `.env` itself is gitignored; never commit real secrets.

# --- General ---
MEDXAI_ENV=dev               # one of: dev | staging | prod

# --- API ---
MEDXAI_API_HOST=0.0.0.0
MEDXAI_API_PORT=8000
MEDXAI_API_KEY=               # optional X-API-Key gate; leave blank to disable

# --- Streamlit -> API ---
MEDXAI_API_URL=http://localhost:8000

# --- MLflow (Phase 2+) ---
MLFLOW_TRACKING_URI=./mlruns

# --- Kaggle (Phase 1; for dataset downloads) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- HuggingFace Hub (Phase 8) ---
HF_TOKEN=

# --- Google Drive DVC remote (Phase 1) ---
# Path to a service-account JSON; OAuth flow is also supported.
GDRIVE_CREDENTIALS_DATA=
